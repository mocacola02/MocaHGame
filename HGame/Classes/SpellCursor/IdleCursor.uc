class IdleCursor extends ParticleFX;

defaultproperties
{
	ParticlesPerSec=(Base=20.0)
	SourceWidth=(Base=3.0)
	SourceHeight=(Base=3.0)
	SourceDepth=(Base=3.0)
	Speed=(Base=0.0)
	Lifetime=(Base=0.30)
	SizeWidth=(Base=4.0)
	SizeLength=(Base=4.0)
	SizeEndScale=(Base=0.75)
	SpinRate=(Base=4.0,Rand=-8.0)
	ParticlesAlive=10
	ColorStart=(Base=(R=255,G=0,B=0))
	ColorEnd=(Base=(R=255,G=255,B=255))
}